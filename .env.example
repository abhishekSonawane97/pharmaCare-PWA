# ───────── Multi-tenant: per-pharmacy Mongo connection strings ─────────
# Each tenant has its own Atlas cluster. Add new tenants to
# apps/api/src/config/tenants.ts + apps/web/src/lib/tenants.ts and
# add the matching env var here.
TENANT_PHARMACARE_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pharmacare?retryWrites=true&w=majority
TENANT_ADILPHARMACY_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adilpharmacy?retryWrites=true&w=majority

# Backwards-compat fallback. Used as TENANT_PHARMACARE_MONGO_URI if the explicit
# var above is not set. Remove once you've migrated everywhere.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pharmacare?retryWrites=true&w=majority

# ───────── JWT secrets (generate with: openssl rand -base64 64) ─────────
# Shared across tenants — one signing authority. The `tenant` claim in the JWT
# tells the server which DB to query.
JWT_ACCESS_SECRET=replace_with_random_64_byte_string
JWT_REFRESH_SECRET=replace_with_different_random_64_byte_string

# ───────── First-admin bootstrap (used by seed script) ─────────
# Generic fallbacks. Override per-tenant with ADMIN_EMAIL_<TENANT_UPPER>
# and ADMIN_PASSWORD_<TENANT_UPPER> if you want different bootstrap creds
# in different tenants.
ADMIN_EMAIL=shaikhabusaeed1@gmail.com
ADMIN_PASSWORD=admin123

# Optional per-tenant overrides (uncomment + customize)
# ADMIN_EMAIL_PHARMACARE=shaikhabusaeed1@gmail.com
# ADMIN_PASSWORD_PHARMACARE=admin123
# ADMIN_EMAIL_ADILPHARMACY=shaikhabusaeed1@gmail.com
# ADMIN_PASSWORD_ADILPHARMACY=admin123

# ───────── Web Push (Phase 4) ──────────────────────────────────────────────
# Generated once with: npx --package=web-push web-push generate-vapid-keys --json
# Shared across all tenants (VAPID identifies the SENDER, not the tenant).
# Without these, the daily reminder cron logs a skip + the frontend's
# "Enable notifications" banner shows a config-missing toast.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service to reach you (mailto: or https:// URL).
VAPID_SUBJECT=mailto:admin@pharmacare.local

# Optional: when the daily reminder cron fires. Format HH:MM in Asia/Kolkata.
# Default 10:00 — matches the old auto-send time.
# PUSH_CRON_TIME=10:00
